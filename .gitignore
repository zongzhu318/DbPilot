# Local SDK, NuGet cache, and generated release/test artifacts
/.tools/
/artifacts/

# .NET / Avalonia build output (all projects)
**/[Bb]in/
**/[Oo]bj/
**/.avalonia-build-tasks/

# IDE user settings; keep shared .vscode settings and workflows trackable
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.sln.iml

# Test results and coverage reports
**/TestResults/
**/coverage/
*.trx
*.coverage
*.coveragexml
coverage.cobertura.xml
coverage.opencover.xml

# Local environment and credentials (example files may be committed)
.env
.env.*
!.env.example
!.env.*.example
secret.key
*.pfx
*.p12
*.ppk
id_rsa
id_ed25519
# Use these directories for repository-local DBPILOT_DATA_DIR or secrets
/.local/
# secrets/ 由 git-crypt 加密后整体纳入版本管理（见 .gitattributes）

# Temporary files, logs, and OS metadata
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini

# Python release tooling cache
__pycache__/
*.pyc

# Sparkle signing key exported by generate_keys
/sparkle-private-key

# Sparkle signing key export (now stored encrypted in secrets/sparkle.env)
/.sparkle-private-key

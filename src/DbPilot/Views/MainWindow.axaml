<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:m="using:DbPilot.Models" xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
 x:Class="DbPilot.Views.MainWindow" Title="DbPilot — 数据库工作台" Icon="/Assets/logo.ico" Width="1360" Height="860" MinWidth="1040" MinHeight="680" Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource WorkspaceText}">
 <Window.Styles>
  <Style Selector="Border.compactBar Button">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="Padding" Value="8,3"/>
   <Setter Property="MinHeight" Value="26"/>
   <Setter Property="MinWidth" Value="0"/>
  </Style>
  <Style Selector="#EditorWorkspaceGrid Button"><Setter Property="FontSize" Value="11"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="7,3"/></Style>
  <Style Selector="#EditorWorkspaceGrid ComboBox"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="7,3"/></Style>
  <Style Selector="#EditorWorkspaceGrid TextBox"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="7,4"/></Style>
  <Style Selector="#TaskLogPanel /template/ ToggleButton"><Setter Property="Background" Value="{DynamicResource SubtleBackground}"/><Setter Property="Foreground" Value="{DynamicResource MutedText}"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="6,2"/></Style>
  <Style Selector="ListBox#QueryTabs"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="#QueryTabs ListBoxItem"><Setter Property="CornerRadius" Value="4"/><Setter Property="Margin" Value="0,0,3,0"/></Style>
  <Style Selector="#QueryTabs ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionText}"/></Style>
  <Style Selector="TreeView#ObjectTree"><Setter Property="Background" Value="Transparent"/></Style>
  <Style Selector="#QueryTabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource SelectionText}"/></Style>
  <Style Selector="#ObjectTree TreeViewItem"><Setter Property="MinHeight" Value="28"/></Style>
  <Style Selector="Expander#TaskLogPanel"><Setter Property="Foreground" Value="{DynamicResource MutedText}"/></Style>
 </Window.Styles>
 <Grid RowDefinitions="Auto,Auto,*,Auto">
  <Border Grid.Row="0" Classes="compactBar" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,3,0,0" Padding="8,2">
   <Grid ColumnDefinitions="Auto,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="6"><Image Source="/Assets/logo.png" Width="22" Height="22"/><TextBlock Text="DbPilot" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
     <Menu Background="Transparent">
      <MenuItem Header="连接"><MenuItem Header="新建连接" Click="NewConnection"/><MenuItem Header="编辑连接" Click="EditConnection"/><MenuItem x:Name="OpenConnectionButton" Header="打开连接" Click="ConnectDatabase"/><MenuItem x:Name="CloseConnectionButton" Header="关闭连接" Click="DisconnectDatabase"/><Separator/><MenuItem Header="复制连接" Click="CopyConnection"/><MenuItem Header="删除连接" Click="DeleteConnection"/><Separator/><MenuItem Header="新建数据库" Click="CreateDatabase"/><MenuItem Header="新建表" Click="CreateTable"/></MenuItem>
      <MenuItem Header="文件"><MenuItem Header="打开脚本" Click="OpenScript"/><MenuItem Header="保存脚本（⌘/Ctrl+S）" Click="SaveScript"/><Separator/><MenuItem Header="查询历史" Click="ShowHistory"/><MenuItem Header="SQL 模板" Click="ShowTemplates"/><MenuItem Header="配置备份" Click="WorkspaceBackup"/></MenuItem>
      <MenuItem Header="工具"><MenuItem Header="执行计划" Click="ExplainSql"/><MenuItem Header="图表" Click="OpenChart"/><MenuItem Header="数据库工具" Click="OpenDatabaseTools"/><Separator/><MenuItem Header="检查更新" Click="CheckForUpdates"/><MenuItem Header="设置" Click="ShowSettings"/></MenuItem>
      <MenuItem Header="视图"><MenuItem Header="显示 / 隐藏侧栏" Click="ToggleSidebar"/><MenuItem Header="展开 / 收起 SQL 编辑器" Click="ToggleEditor"/><MenuItem Header="显示 / 隐藏日志" Click="ToggleLogs"/><MenuItem Header="专注模式（⌘/Ctrl+Shift+F）" Click="ToggleFocusMode"/></MenuItem>
      <MenuItem Header="切换主题" Click="ToggleTheme"/>
     </Menu>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"><Button Content="侧栏" Click="ToggleSidebar" ToolTip.Tip="显示或隐藏连接侧栏"/><Button x:Name="EditorToggleButton" Content="收起 SQL" Click="ToggleEditor"/><Button x:Name="FocusModeButton" Content="专注模式" Click="ToggleFocusMode" ToolTip.Tip="隐藏侧栏、SQL 编辑器与日志，将空间留给表数据"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Classes="compactBar" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="0,1" Padding="8,2">
   <StackPanel Orientation="Horizontal" Spacing="4">
    <Button Content="＋ 连接" Click="NewConnection"/>
    <Button x:Name="ShowTablesButton" Content="表列表" Click="ShowCatalog"/>
    <Button Content="＋ 查询" ToolTip.Tip="新建查询（⌘/Ctrl+N）" Click="NewQuery"/>
    <Button x:Name="ExecuteSqlButton" Content="▶ 执行" ToolTip.Tip="执行选中 SQL；未选中时执行整个脚本" Classes="primary" Click="RunSql"/>
    <Button x:Name="StopSqlButton" Content="■ 终止" Click="StopSql"/>
    <Button Content="格式化" Click="FormatSql"/><Button Content="保存 SQL" Click="SaveScript" ToolTip.Tip="⌘/Ctrl+S"/><Button Content="导出结果" Click="ExportResult"/>
   </StackPanel>
  </Border>
  <Grid Grid.Row="2" ColumnDefinitions="220,4,*" x:Name="WorkspaceGrid">
   <Grid x:Name="SidebarPanel" Background="{DynamicResource SidebarBackground}" RowDefinitions="Auto,Auto,*,Auto" Margin="8,6,6,4">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="连接与数据库" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="刷新" Click="RefreshTree" Padding="7,4"/></Grid>
    <TextBox Grid.Row="1" x:Name="ObjectFilter" Watermark="搜索连接 / 已加载对象…" Margin="0,6,0,5" TextChanged="FilterObjects"/>
    <TreeView Grid.Row="2" x:Name="ObjectTree" ItemsSource="{Binding Nodes}" DoubleTapped="OpenNode" PointerPressed="TreePointerPressed">
     <TreeView.Styles><Style Selector="TreeViewItem"><Setter Property="IsVisible" Value="{Binding Visible}"/></Style></TreeView.Styles>
     <TreeView.ItemTemplate><TreeDataTemplate DataType="m:ObjectNode" ItemsSource="{Binding Children}"><StackPanel Orientation="Horizontal" Spacing="7" Margin="2,2"><Border IsVisible="{Binding IsConnection}" Background="{Binding IconColor}" CornerRadius="4" Width="28" Height="22"><TextBlock Text="{Binding DatabaseIcon}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/></StackPanel></TreeDataTemplate></TreeView.ItemTemplate>
     <TreeView.ContextMenu><ContextMenu/></TreeView.ContextMenu>
    </TreeView>
    <TextBlock Grid.Row="3" Text="双击连接加载数据库，双击表浏览数据" FontSize="10" Opacity="0.55" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </Grid>
   <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Background="{DynamicResource WorkspaceBorder}" ResizeDirection="Columns"/>
   <Grid Grid.Column="2" RowDefinitions="Auto,Auto,1*,4,2*,Auto" Margin="6,4,6,4" x:Name="EditorWorkspaceGrid">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
     <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="连接" VerticalAlignment="Center" Opacity="0.6"/><ComboBox x:Name="ConnectionPicker" Width="190" MinHeight="28" Padding="7,3" ItemsSource="{Binding Connections}" SelectedItem="{Binding Connection, Mode=TwoWay}" SelectionChanged="ChangeConnection"/><TextBlock Text="数据库" VerticalAlignment="Center" Opacity="0.6"/><ComboBox x:Name="DatabasePicker" Width="170" MinHeight="28" Padding="7,3" PlaceholderText="选择数据库" SelectionChanged="ChangeDatabase"/><Button Content="刷新库" Click="ReloadDatabases" Padding="7,3" MinHeight="26" FontSize="11"/></StackPanel>
     <TextBlock Grid.Column="1" Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Opacity="0.5" FontSize="11"/>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
     <TabStrip x:Name="WorkspaceModeTabs" SelectedIndex="1" SelectionChanged="ChangeWorkspaceMode" Margin="0,0,8,0" MinHeight="28" FontSize="11"><TabStripItem Content="数据表" FontSize="11" Padding="10,3" MinHeight="28"/><TabStripItem Content="SQL 查询" FontSize="11" Padding="10,3" MinHeight="28"/></TabStrip>
     <ListBox Grid.Column="1" x:Name="QueryTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Tab, Mode=TwoWay}" SelectionChanged="ChangeTab" Height="28" MinHeight="0" Padding="0" FontSize="11" DragDrop.AllowDrop="True" PointerPressed="TabsPointerPressed" PointerMoved="TabsPointerMoved">
      <ListBox.Styles>
       <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="Margin" Value="0"/>
       </Style>
      </ListBox.Styles>
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" ToolTip.Tip="{Binding ContextLabel}"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button Grid.Column="2" Content="关闭查询" ToolTip.Tip="关闭当前查询（⌘/Ctrl+W）" Click="CloseTab" FontSize="11" Padding="8,3" MinHeight="0" Height="28"/>
    </Grid>
    <Border x:Name="EditorPane" Background="{DynamicResource PanelBackground}" CornerRadius="5" Grid.Row="2" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" Padding="2" Margin="0,3,0,0">
     <edit:TextEditor x:Name="SqlEditor" ShowLineNumbers="True" FontFamily="Cascadia Code,Consolas,monospace" FontSize="14" Background="Transparent" KeyDown="EditorKeyDown">
      <edit:TextEditor.ContextMenu><ContextMenu><MenuItem x:Name="ExecuteEditorSqlMenu" Header="执行 SQL" Click="RunSql"/><MenuItem x:Name="FormatEditorSqlMenu" Header="格式化 SQL" Click="FormatSql"/></ContextMenu></edit:TextEditor.ContextMenu>
     </edit:TextEditor>
    </Border>
    <GridSplitter x:Name="EditorSplitter" Grid.Row="3" ResizeDirection="Rows" HorizontalAlignment="Stretch" Background="{DynamicResource WorkspaceBorder}"/>
    <Grid Grid.Row="4" RowDefinitions="Auto,Auto,*,Auto">
     <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
      <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="查询结果" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="ResultPicker" MinWidth="170" SelectionChanged="ChangeResult"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5"><Button Content="字段详情" Click="ViewCell" Padding="7,4"/><Button Content="复制单元格" Click="CopyCell" Padding="7,4"/><Button Content="复制行" Click="CopyRow" Padding="7,4"/><TextBlock x:Name="RowCount" Text="0 行" VerticalAlignment="Center" Margin="8,0" Opacity="0.6"/></StackPanel>
     </Grid>
     <WrapPanel x:Name="EditToolbar" Grid.Row="1" Margin="0,0,0,4">
      <Button x:Name="AddRowButton" Content="＋ 新增行" Click="AddDataRow" Margin="0,0,5,0" Padding="8,4"/>
      <Button x:Name="DeleteRowButton" Content="删除选中行" Click="DeleteDataRow" Margin="0,0,5,0" Padding="8,4"/>
      <Button x:Name="NullCellButton" Content="设为 NULL" Click="SetCellNull" Margin="0,0,5,0" Padding="8,4"/>
      <Button x:Name="CommitEditsButton" Classes="primary" Content="提交变更" Click="CommitDataEdits" Margin="0,0,5,0" Padding="8,4"/>
      <Button x:Name="RevertEditsButton" Content="撤销变更" Click="RevertDataEdits" Margin="0,0,8,0" Padding="8,4"/>
      <TextBlock x:Name="EditStatus" Text="只读结果" VerticalAlignment="Center" Opacity="0.65" FontSize="11"/>
     </WrapPanel>
     <DataGrid Grid.Row="2" x:Name="Results" IsReadOnly="True" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" SelectionMode="Single" BorderThickness="1" BorderBrush="{DynamicResource WorkspaceBorder}"/>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="5" Margin="0,4,0,0">
      <TextBox x:Name="WhereFilter" Width="300" Watermark="WHERE 条件，例如 id &gt; 100（Enter 筛选）" KeyDown="FilterKeyDown"/>
      <Button x:Name="ApplyFilterButton" Content="筛选" Click="ApplyFilter"/><Button x:Name="PreviousPageButton" Content="上一页" Click="PreviousPage"/><TextBlock x:Name="PageLabel" Text="第 1 页" VerticalAlignment="Center"/><Button x:Name="NextPageButton" Content="下一页" Click="NextPage"/>
      <ComboBox x:Name="PageSize" SelectedIndex="2" Width="85"><ComboBoxItem Content="20"/><ComboBoxItem Content="50"/><ComboBoxItem Content="100"/><ComboBoxItem Content="500"/></ComboBox>
     </StackPanel>
    </Grid>
    <Border x:Name="TableCatalogPanel" Grid.Row="2" Grid.RowSpan="3" IsVisible="False" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource WorkspaceBorder}" BorderThickness="1" Padding="8">
     <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,240,Auto" Margin="0,0,0,6">
       <TextBlock x:Name="TableCatalogTitle" Text="数据表" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
       <TextBox Grid.Column="1" x:Name="TableCatalogFilter" Watermark="筛选表名 / 架构 / 类型…" TextChanged="FilterTableCatalog" KeyDown="CatalogKeyDown"/>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0"><Button Content="×" Click="ClearCatalogFilter" ToolTip.Tip="清空筛选"/><Button Content="刷新" Click="ReloadTableCatalog"/><Button Content="返回 SQL" Click="HideTableCatalog"/></StackPanel>
      </Grid>
      <DataGrid Grid.Row="1" x:Name="TableCatalogGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" DoubleTapped="OpenCatalogTable" KeyDown="CatalogKeyDown">
       <DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu>
       <DataGrid.Columns><DataGridTextColumn Header="表名" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="架构" Binding="{Binding Schema}" Width="160"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="120"/></DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="2" x:Name="TableCatalogSummary" Margin="0,6,0,0" Opacity="0.65" TextWrapping="Wrap"/>
     </Grid>
    </Border>
    <Expander x:Name="TaskLogPanel" Grid.Row="5" Header="消息与任务日志（点击展开）" IsExpanded="False" MaxHeight="130" MinHeight="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
     <Grid ColumnDefinitions="*,Auto"><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas,monospace" FontSize="11" MaxHeight="105"/><Button Grid.Column="1" Content="清空" Click="ClearLogs" VerticalAlignment="Top"/></Grid>
    </Expander>
   </Grid>
  </Grid>
  <Border Grid.Row="3" Background="{DynamicResource StatusBackground}" Padding="10,3"><Grid ColumnDefinitions="*,Auto"><TextBlock Foreground="{DynamicResource StatusText}" Text="{Binding Status}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Foreground="{DynamicResource StatusText}" Opacity="0.8" Text="DbPilot 0.3 · 数据库工具" FontSize="11"/></Grid></Border>
 </Grid>
</Window>
